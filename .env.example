# ==============================================================================
# OP25-TAP Unified Configuration Plane
# ==============================================================================

# Target OP25 receiver HTTP endpoint (serves the web dashboard & JSON telemetry)
OP25_URL=http://<op25-host>:8080/

# Optional: Port 9000 raw PCM WebSocket audio URL.
# If left blank, it automatically derives ws://<hostname>:9000 from OP25_URL
OP25_AUDIO_WS=

# How frequently (in seconds) the poller fetches status from OP25
OP25_POLL_INTERVAL=1.0

# Transmission hold time (in seconds) before closing an inactive call
OP25_HOLD_SECONDS=3.0

# Optional fallback system label if OP25 does not report a system name
OP25_SYSTEM_NAME=County P25

# Application Server Host & Port binding
HOST=0.0.0.0
PORT=8000

# Data Storage Directory (SQLite database, etc.)
# Local default: ./data, Docker default: /app/data
OP25TAP_DATA_DIR=./data

# ==============================================================================
# Remote Whisper Speech-to-Text Transcription
# ==============================================================================
# Target OpenAI-compatible transcription endpoint (e.g. Faster-Whisper, LocalAI, etc.)
# Leave blank to disable transcription
WHISPER_URL=http://<whisper-host>:8000/v1/audio/transcriptions

# Model name passed to Whisper API (e.g. base.en, small, whisper-1)
WHISPER_MODEL=base.en

# Optional Bearer token / API key
WHISPER_API_KEY=

# Spoken language hint
WHISPER_LANGUAGE=en

# Audio retention window (in hours) to store call WAV files for UI playback (0 to disable)
WHISPER_RETENTION_HOURS=24

# Note: For multi-receiver polling arrays or custom hex NAC/SYSID mapping tables,
# see the optional JSON configs in config/ (documented in config/README.md).


